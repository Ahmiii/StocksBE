generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String          @unique @db.VarChar(255)
  passwordHash   String          @map("password_hash") @db.VarChar(255)
  fullName       String          @map("full_name") @db.VarChar(120)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  brokerAccounts BrokerAccount[]
  portfolios     Portfolio[]
  watchlistItems WatchlistItem[]

  @@map("users")
}

model BrokerAccount {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  broker         String      @default("AHL_ETRADE") @db.VarChar(32)
  clientCode     String      @map("client_code") @db.VarChar(64)
  credentialsEnc String?     @map("credentials_enc")
  tokenExpiresAt DateTime?   @map("token_expires_at") @db.Timestamptz
  syncStatus     String      @default("idle") @map("sync_status") @db.VarChar(16)
  syncCursor     String?     @map("sync_cursor") @db.VarChar(255)
  lastSyncedAt   DateTime?   @map("last_synced_at") @db.Timestamptz
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  user           User        @relation(fields: [userId], references: [id])
  portfolios     Portfolio[]
  trades         Trade[]

  @@unique([userId, broker, clientCode])
  @@index([userId])
  @@map("broker_accounts")
}

model Portfolio {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  brokerAccountId String?        @unique @map("broker_account_id") @db.Uuid
  name            String         @db.VarChar(120)
  baseCurrency    String         @default("PKR") @map("base_currency") @db.Char(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  user            User           @relation(fields: [userId], references: [id])
  brokerAccount   BrokerAccount? @relation(fields: [brokerAccountId], references: [id])
  trades          Trade[]
  positions       Position[]

  @@index([userId])
  @@map("portfolios")
}

model Security {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  symbol         String          @unique @db.VarChar(16)
  isin           String?         @unique @db.VarChar(12)
  companyName    String          @map("company_name") @db.VarChar(255)
  sector         String?         @db.VarChar(120)
  listingStatus  String          @default("listed") @map("listing_status") @db.VarChar(16)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  trades           Trade[]
  positions        Position[]
  dailyPrices      DailyPrice[]
  watchlistItems   WatchlistItem[]
  corporateActions CorporateAction[] @relation("actionsOf")
  mergedFrom       CorporateAction[] @relation("mergedInto")

  @@map("securities")
}

// One event that changes what a share is worth or how many you hold.
// DIVIDEND: amount = Rs per share. BONUS / SPLIT: ratio = new shares per old.
// RIGHTS: ratio = entitlement per share, amount = subscription price.
// MERGER: ratio = new shares per old, toSecurity = the new symbol.
model CorporateAction {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  securityId   String    @map("security_id") @db.Uuid
  type         String    @db.VarChar(16)
  exDate       DateTime  @map("ex_date") @db.Date
  ratio        Decimal?  @db.Decimal(18, 8)
  amount       Decimal?  @db.Decimal(18, 4)
  toSecurityId String?   @map("to_security_id") @db.Uuid
  source       String    @db.VarChar(16)
  providerId   String?   @map("provider_id") @db.VarChar(32)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  security     Security  @relation("actionsOf", fields: [securityId], references: [id])
  toSecurity   Security? @relation("mergedInto", fields: [toSecurityId], references: [id])

  @@unique([securityId, type, exDate])
  @@map("corporate_actions")
}

model WatchlistItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  securityId String   @map("security_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user     User     @relation(fields: [userId], references: [id])
  security Security @relation(fields: [securityId], references: [id])

  // Adding the same symbol twice is a no-op rather than a duplicate row.
  @@unique([userId, securityId])
  @@index([userId])
  @@map("watchlist_items")
}

model Trade {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  portfolioId     String   @map("portfolio_id") @db.Uuid
  securityId      String   @map("security_id") @db.Uuid
  brokerAccountId String?  @map("broker_account_id") @db.Uuid
  brokerTradeId   String?  @map("broker_trade_id") @db.VarChar(64)
  brokerOrderId   String?  @map("broker_order_id") @db.VarChar(64)
  side            String   @db.VarChar(4)
  quantity        Decimal  @db.Decimal(18, 4)
  price           Decimal  @db.Decimal(18, 4)
  commission      Decimal  @default(0) @db.Decimal(18, 4)
  taxesLevies     Decimal  @default(0) @map("taxes_levies") @db.Decimal(18, 4)
  netAmount       Decimal  @map("net_amount") @db.Decimal(18, 4)
  executedAt      DateTime @map("executed_at") @db.Timestamptz
  source          String   @default("broker_sync") @db.VarChar(16)
  rawPayload      Json?    @map("raw_payload")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  portfolio     Portfolio      @relation(fields: [portfolioId], references: [id])
  security      Security       @relation(fields: [securityId], references: [id])
  brokerAccount BrokerAccount? @relation(fields: [brokerAccountId], references: [id], onDelete: Restrict)

  @@unique([brokerAccountId, brokerTradeId])
  @@index([portfolioId, executedAt(sort: Desc)])
  @@index([securityId])
  @@map("trades")
}

model Position {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  portfolioId String    @map("portfolio_id") @db.Uuid
  securityId  String    @map("security_id") @db.Uuid
  quantity    Decimal   @default(0) @db.Decimal(18, 4)
  avgCost     Decimal   @default(0) @map("avg_cost") @db.Decimal(18, 4)
  realizedPnl Decimal   @default(0) @map("realized_pnl") @db.Decimal(18, 4)
  asOf        DateTime  @default(now()) @map("as_of") @db.Timestamptz
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id])
  security    Security  @relation(fields: [securityId], references: [id])

  @@unique([portfolioId, securityId])
  @@index([securityId])
  @@map("positions")
}

model DailyPrice {
  id         BigInt   @id @default(autoincrement())
  securityId String   @map("security_id") @db.Uuid
  tradeDate  DateTime @map("trade_date") @db.Date
  open       Decimal? @db.Decimal(18, 4)
  high       Decimal? @db.Decimal(18, 4)
  low        Decimal? @db.Decimal(18, 4)
  close      Decimal  @db.Decimal(18, 4)
  volume     BigInt?
  fetchedAt  DateTime @default(now()) @map("fetched_at") @db.Timestamptz

  // Relations
  security Security @relation(fields: [securityId], references: [id])

  // Composite unique constraint
  @@unique([securityId, tradeDate])
  @@map("daily_prices")
}
